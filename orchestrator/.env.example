# Copy to .env and fill in. Every variable is read in navigator/config.py.

# Claude. NAVIGATOR_LLM: auto (on when ANTHROPIC_API_KEY is set), on, or off (rule-based fallbacks).
ANTHROPIC_API_KEY=
NAVIGATOR_LLM=auto
LLM_MODEL=claude-opus-5-5
CRITIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=60

# Specialists (Peter's agents)
LENDER_MATCH_URL=
SPECIALIST_TIMEOUT_S=30

# PLACEHOLDER: current 30-year fixed rate (e.g. Freddie Mac PMMS). Empty = no DTI estimate.
ASSUMED_RATE_PCT=

# Signals (PLACEHOLDER thresholds until calibration, design.md §8)
APPROVAL_GREEN=0.80
APPROVAL_YELLOW=0.60
MIN_LENDER_APPLICATIONS=200

# Loop limits and stopping rules
MAX_ROUNDS=6
MAX_REVISIONS=2
MAX_INTAKE_TURNS=8
NO_PROGRESS_ROUNDS=2
MATERIAL_ODDS_CHANGE=0.02

# Service area: dc_metro (default) or any
SERVICE_AREA=dc_metro

# Keep traces (which contain profile data) on this machine
LANGSMITH_TRACING=false
